{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Endfield Pull Tracker",
  "version": "0.1.0",
  "identifier": "com.endfield.gacha.tui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Simple Endfield Pull Tracker",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
